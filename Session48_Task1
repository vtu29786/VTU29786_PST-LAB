Scenario:

A music application maintains songs in a playlist. Users can add songs and remove a song they no longer want. Implement a linked list playlist that supports adding songs, removing a song, and displaying the playlist.

Program:

class Node {
    String song;
    Node next;

    Node(String song) {
        this.song = song;
        this.next = null;
    }
}

public class MusicPlaylist {
    Node head;

    void addSong(String song) {
        Node newNode = new Node(song);

        if (head == null) {
            head = newNode;
        } else {
            Node temp = head;

            while (temp.next != null) {
                temp = temp.next;
            }

            temp.next = newNode;
        }
    }

    void removeSong(String song) {
        if (head == null) {
            return;
        }

        if (head.song.equals(song)) {
            head = head.next;
            System.out.println(song + " removed.");
            return;
        }

        Node temp = head;

        while (temp.next != null &&
               !temp.next.song.equals(song)) {
            temp = temp.next;
        }

        if (temp.next != null) {
            temp.next = temp.next.next;
            System.out.println(song + " removed.");
        } else {
            System.out.println(song + " not found.");
        }
    }

    void display() {
        Node temp = head;

        System.out.println("Music Playlist:");

        while (temp != null) {
            System.out.println(temp.song);
            temp = temp.next;
        }
    }

    public static void main(String[] args) {
        MusicPlaylist playlist = new MusicPlaylist();

        playlist.addSong("Perfect");
        playlist.addSong("Shape of You");
        playlist.addSong("Believer");

        playlist.display();

        playlist.removeSong("Shape of You");

        playlist.display();
    }
}

